# Copy to .env.local (git-ignored). Expo inlines EXPO_PUBLIC_* values at build time; they are
# visible in the app bundle, so only use the project's public anon key here.
# Data source: "fixtures" (bundled sample data) or "supabase" (live EIA fuel prices).
EXPO_PUBLIC_DATA_SOURCE=fixtures
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
